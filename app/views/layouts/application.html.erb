<!DOCTYPE html>
<html>
  <head>
    <title>Zukan</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script src="http://code.jquery.com/jquery.min.js"></script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %> 
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <script src="https://kit.fontawesome.com/3006deca4b.js" crossorigin="anonymous"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Yusei+Magic&display=swap" rel="stylesheet">
    <meta name="turbo-cache-control" content="no-cache">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <!-- <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %> -->
    <%= javascript_importmap_tags %>
    <!-- <%= javascript_include_tag "//www.google.com/jsapi", "chartkick" %> -->
    <!-- javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' -->
    <!-- stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' -->
    
  </head>
  <body class="d-flex flex-column vh-100">
    <header>
      <div class="w-100 py-4 text-white" style="background-color: #FFB2B3;" >
        <h1 class="yusei-magic-regular text-center">
          <%= link_to "いきもの掲示板　5", posts_path, class: 'yusei-magic-regular text-center text-white text-decoration-none' %>
        </h1>
      </div>
      <div class="w-100" style="background-color: #F3E2BE;">
        <%= form_with url: search_path, local: true, method: :get, class: "form-inline py-1 mx-auto d-flex justify-content-center" do |f| %>
          <div class="px-1"><%= f.select :range, options_for_select([["投稿", 'Post'], ["ユーザー", 'User']]) %></div>
          <div class="px-1"><%= f.text_field :word , class: "form-control form-control-sm" %></div>
          <div class="px-1"><%= f.submit '検索', class: "btn btn-dark btn-sm text-light px-3" %></div>
        <% end %>
      </div>
      <div>
        <nav class="navbar navbar-expand-lg navbar-light bg-light mb-3">
          <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarToggler" aria-controls="navbarToggler" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarToggler" >
            <ul class="navbar-nav ms-auto mt-2 mt-lg-0 pt-3" >
              <% if user_signed_in? %>
                <li class="nav-item" style="width: 112px" >
                  <%= link_to(new_post_path, class: 'nav-link', style: 'color: #494C4D;' ) do %>
                    <div class="mb-4 d-flex justify-content-center"><i class="fa-solid fa-square-plus fa-2xl"></i></div>
                    <h6 class="text-center">新規作成</h6>
                  <% end %>
                </li>
                <li class="nav-item" style="width: 112px;">
                  <%= link_to(user_path(current_user.id) , class: 'nav-link', style: 'color: #494C4D;') do %>
                    <div class="mb-4 d-flex justify-content-center"><i class="fa-solid fa-circle-user fa-2xl"></i></div>
                    <h6 class="text-center">マイページ</h6>
                  <% end %>
                </li>
                <li class="nav-item" style="width: 112px">
                  <%= link_to(bookmarked_path , class: 'nav-link', style: 'color: #494C4D;') do %>
                    <div class="mb-4 d-flex justify-content-center"><i class="fa-solid fa-bookmark fa-2xl"></i></div>
                    <h6 class="text-center">ブックマーク</h6>
                  <% end %>
                </li>
                <li class="nav-item d-flex justify-content-center" style="width: 112px">
                  <%= button_to(destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, form: { onSubmit: 'return DeleteCheck("logout")' }, class: 'nav-link', style: 'border: none; color: #494C4D; background-color: #F8F9FA') do %>
                    <div class="mb-4 d-flex justify-content-center"><i class="fa-solid fa-arrow-right-from-bracket fa-2xl"></i></div>
                    <h6 class="text-center">ログアウト</h6>
                  <% end %>
                </li>
              <% else %>
                <li class="nav-item">
                  <%= link_to "TOP", posts_path, class: 'nav-link text-dark' %>
                </li>
                <li class="nav-item">
                  <%= link_to "新規登録", new_user_registration_path, class: 'nav-link text-dark' %>
                </li>
                <li class="nav-item">
                  <%= link_to "ログイン", new_user_session_path, class: 'nav-link text-dark' %>
                </li>
              <% end %>
            </ul>
          </div>
        </nav>
      </div>
      <% flash.each do |message_type, message| %>
        <div class="flash-message alert alert-<%= message_type %>" role="alert"><%= message %></div>
      <% end %>
    </header>

    <main class="container-xl mb-auto">
      <%= yield %>
    </main>

    <footer class="bg-dark text-white mt-5 pt-4 pb-4">
      <div class="container">
        <div class="row no-gutters">
          <div class="col text-center">
             <%= link_to "TOPページ", root_path, class: "text-white-50", data: {"turbolinks" => false}%>
          </div>
        </div>
      </div>
    </footer>

    <script>
      /*
      window.onload = function(){
        const preview = document.getElementById("preview-area");
        const fileInput = document.getElementById("post_image") || document.getElementById("user_profile_image");

        console.log("読み込み完了");
        fileInput.addEventListener("change", previewFile);

        function previewFile() {
          const file = fileInput.files[0];
          const reader = new FileReader();
  
          reader.addEventListener("load", () => {
            preview.style.backgroundImage = `url(${reader.result})`;
