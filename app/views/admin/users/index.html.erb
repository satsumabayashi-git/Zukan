<h4 class="m-4 headline" style="color: #494C4D;">
  <strong>ユーザー一覧</strong>
</h4>

<div class="d-flex flex-wrap justify-content-center">
<% @users.each do |user| %>
  <div class="card rounded container-md my-5" style="filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25)); width: 400px; height: 450px; background-color: #F8F9FA;">
    <div class="card-body">
      <div class="mx-auto">
        <div class="d-flex justify-content-center">
          <%= link_to user_path(user.id), class: "" do %>
            <%= image_tag user.get_profile_image(100, 100), class: " border rounded-circle" %>
          <% end %>
        </div>
        <div class="text-dark text-center">
          <h5 class="my-1 text-truncate"><%= user.name %></h5>
        </div>

        <hr class="mt-2">

        <div class="mb-3">
          <div class="col-sm " style="max-width: 150px"><h6>好きな動物：</h6></div>
          <div class="col-sm  ps-0"><h6 class="text-truncate"><%= user.favorite_animal %></h6></div>
        </div>
        <div class="mb-3">
          <div class="col-sm " style="max-width: 150px"><h6>自己紹介：</h6></div>
          <div class="col-sm  ps-0"><h6 class="text-truncate"><%= user.introduction %></h6></div>
        </div>
        <div class="mb-3">
          <div class="col-sm " style="max-width: 150px"><h6>メールアドレス：</h6></div>
          <div class="col-sm  ps-0"><h6 class="text-truncate"><%= user.email %></h6></div>
        </div>
        <div class="d-flex justify-content-center">
          <%= button_to(admin_user_path(user), method: :delete, form: { onSubmit: 'return DeleteCheck("user")' }, class: "btn btn-danger") do %>
            <i class="fa-regular fa-trash-can"></i>
            <span>ユーザーを削除</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>