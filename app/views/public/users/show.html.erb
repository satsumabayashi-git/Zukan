<h4 class="m-4">
  <strong><%= link_to "プロフィール", user_path(@user.id), class: "headline", style: "color: #494C4D;" %></strong>
</h4>


<div class="card rounded container-md my-5" style="filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25)); background-color: #F8F9FA;">
  <div class="card-body">
    <div class="mx-auto" style="max-width: 600px;">
      <div class="row d-flex flex-wrap mb-4">
        <div class="mx-3">
          <%= link_to user_path(@user.id), class: "" do %>
            <%= image_tag @user.get_profile_image(120, 120), class: "translate-middle border rounded-circle" %>
          <% end %>
        </div>
        <div class="d-flex align-items-center text-dark">
          <h4 class="mb-0"><%= @user.name %></h4>
        </div>
      </div>
      <div class="row justify-content-center mb-4">
        <div class="col-sm py-2" style="max-width: 150px"><h5>好きな動物：</h5></div>
        <div class="col-sm py-2 pl-0"><h5><%= @user.favorite_animal %></h5></div>
      </div>
      <div class="row mx-2">
        <h5><%= @user.introduction %></h5>
      </div>
    </div>
      <% if @user == current_user %>
        <div class="d-flex justify-content-end">
          <%= button_to(edit_user_path(@user.id), method: :get, data: { turbo_method: :get }, class: "btn btn-danger", style: "background-color: #CB30E0;") do %>
          <i class="fa-regular fa-pen-to-square"></i>
          <span>編集</span>
          <% end %>
        </div>
      <% end %>
  </div>
</div>

<%= render 'public/posts/list', posts: @posts %>