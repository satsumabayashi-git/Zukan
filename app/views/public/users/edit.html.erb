<h4 class="m-4">
  <strong><%= link_to "プロフィール編集", edit_user_path(@user.id), class: "headline", style: "color: #494C4D;" %></strong>
</h4>

<% if @user.errors.any? %>
  <%= @user.errors.count %>件のエラーが発生しました
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<div class="card rounded container-lg my-4" style="filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25));">
  <%= form_with model: @user do |f| %>
    <div class="row mt-5">
      <div class="col-md-3 py-2 pl-4"><h6>ユーザー名</h6></div>
      <div class="col-md-8"><%= f.text_field :name, class: "form-control", placeholder:"ユーザー名" %></div>
    </div>
    <div class="row mt-3">
      <div class="col-md-3 py-2 pl-4"><h6>プロフィール画像</h6></div>
      <div class="col-md-8">
        <%= f.label :profile_image , "画像をアップロード", class: "btn btn-primary" %>
        <%= f.file_field :profile_image, accept: "image/jpeg", class: "", style: "display: none;" %>
      </div>
    </div>
    <!-- <div class="p-3 mx-auto rounded-circle translate-middle" style="width: 0px; height: 0px; background-size: contain; background-repeat: no-repeat; background-position: center;" id="preview"></div> -->
    
    <div class="d-flex justify-content-center">
      <img src="" class="p-3 mx-auto rounded-circle translate-middle" style="width: 0px; height: 0px; background-size: cover; background-repeat: no-repeat; background-position: center;" id="preview">
    </div>
    <div class="row mt-3">
      <div class="col-md-3 py-2 pl-4"><h6>自己紹介</h6></div>
      <div class="col-md-8">
        <%= f.text_area :introduction, autofocus: true, class: "form-control", placeholder:"自己紹介" %>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-md-3 py-2 pl-4"><h6>好きな動物</h6></div>
      <div class="col-md-8">
        <%= f.text_field :favorite_animal, autofocus: true, class: "form-control", placeholder:"好きな動物" %>
      </div>
    </div>
    <div class="row justify-content-center mx-auto mt-3 mb-3">
      <div class="col-md-5">
        <%= f.submit "変更を保存", class: "btn btn-lg btn-block btn-info" %>
      </div>
    </div>
  <% end %>
  <div class="d-flex justify-content-end mb-3">
    <%= button_to 'アカウントを削除する', user_path(@user.id), method: :delete, data: { turbo_method: :delete, confirm: 'アカウントを削除しますか？' }, class: "btn btn-secondary" %>
  </div>
</div>

<script>
  const preview = document.getElementById("preview");
  const fileInput = document.getElementById("user_profile_image");
  
  fileInput.addEventListener("change", previewFile);
  
  function previewFile() {
    const file = fileInput.files[0];
    const reader = new FileReader();
  
    reader.addEventListener("load", () => {
      // 画像ファイルを base64 文字列に変換
      preview.style.backgroundImage = `url(${reader.result})`;
      preview.style.width = "200px";
      preview.style.height = "200px";
    });
  
    if (file) {
      reader.readAsDataURL(file);
    }
  }
</script>