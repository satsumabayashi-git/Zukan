<h4 class="m-4">
  <strong>
    <%= link_to posts_path, class: "headline text-decoration-none", style: "color: #494C4D;" do %>
    カテゴリ検索：<%= Category.find(params[:category_id]).name %>
    <% end %>
  </strong>
</h4>

<div class="container-lg">
  <div class="d-flex m-4">
    <!-- カテゴリ検索ボタン -->
    <div class="dropdown me-auto">
      <button class="btn btn-info text-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        カテゴリ検索
      </button>
      <ul class="dropdown-menu">
        <% Category.all.each do |category| %>
          <li>
            <%= link_to "#{category.name}", categorized_path(category.id), class: "dropdown-item" %>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- ソートボタン -->
    <div class="ms-auto">
      <ul class="nav nav-pills">
        <% case params[:order] %>
        <% when "old" then %>
          <li class="nav-item"><%= link_to "新着順", posts_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "古い順", posts_path(order: "old"), class: "nav-link active" %></li>
          <li class="nav-item"><%= link_to "ブックマーク順", posts_path(order: "bookmark"), class: "nav-link" %> </li>
        <% when "bookmark" then %>
          <li class="nav-item"><%= link_to "新着順", posts_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "古い順", posts_path(order: "old"), class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "ブックマーク順", posts_path(order: "bookmark"), class: "nav-link active" %> </li>
        <% else %>
          <li class="nav-item"><%= link_to "新着順", posts_path, class: "nav-link active" %></li>
          <li class="nav-item"><%= link_to "古い順", posts_path(order: "old"), class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "ブックマーク順", posts_path(order: "bookmark"), class: "nav-link" %> </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%= render 'list', posts: @posts %>
</div>