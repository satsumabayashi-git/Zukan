<div class="d-flex flex-wrap justify-content-center">
  <% posts.each do |post| %>
  <div class="mt-4 mx-2" style="width: 223px; height: 300px; filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25));">
    <div>
      <%= link_to categorized_path(post.category.id) do %>
        <button class="btn btn-info btn-sm text-light" style="width: 120px; font-size: 12px;"><%= post.category.name %></button>
      <% end %>
    </div>

    <div class="mx-auto card rounded" style="width: 223px; height: 260px; background-color: #F8F9FA;">
      <div class="card-body p-2">
        <h6 class="mx-auto card-title text-center text-truncate text-dark" style="max-width: 215px;">
          <%= post.body %>
        </h6>
        <div class="d-flex w-100" style="height: 140px;">
          <%= link_to post_path(post.id), class: "mx-auto my-auto" do %>
            <%= image_tag post.get_image(200,130), class: "img-thumbnail border rounded" %>
          <% end %>
        </div>


        <div class="mt-1 mb-1 d-flex flex-row">
          <div class="me-2">
            <%= link_to user_path(post.user.id), class: "" do %>
              <%= image_tag post.user.get_profile_image(25, 25), class: "border rounded-circle" %>
            <% end %>
          </div>
          <h6 class="mb-0 pt-2 text-justify text-truncate" style="font-size: 12px; max-width: 150px;">
            <%= post.user.name %>
          </h6>
        </div>
          
        <hr class="my-1" style="border-color: #494C4D;">

        <div class="d-flex ps-3">
          <div class="">
            <%= link_to post_path(post.id), class: "d-flex flex-row me-3 text-decoration-none", style: 'color: #494C4D' do %>
              <i class="fa-regular fa-message my-auto"></i>
              <p class="text-dark my-0 ms-2"><%= post.post_comments.count %></p>
            <% end %>
          </div>
          <div class="d-flex">
            <% if post.bookmarked_by?(current_user) %>
              <%= button_to(post_bookmark_path(post), method: :delete, data: { turbo_method: :delete }, class: "d-flex flex-row me-3", style: 'color: #494C4D; border: none; background-color: #F8F9FA;') do %>
                <i class="fa-solid fa-bookmark my-auto"></i>
                <p class="my-0 ms-2"><%= post.bookmarks.count %></p>
              <% end %>
            <% else %>
              <%= button_to(post_bookmark_path(post), method: :post, data: { turbo_method: :post }, class: "d-flex flex-row me-3", style: 'color: #494C4D; border: none; background-color: #F8F9FA;') do %>
                <i class="fa-regular fa-bookmark my-auto"></i>
                <p class="my-0 ms-2"><%= post.bookmarks.count %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>

<div class="pagination d-flex justify-content-center mt-5">
  <%= paginate posts %>
</div>