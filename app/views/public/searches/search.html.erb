<h4 class="m-4">
  <strong>検索結果</strong>
</h4>

<div class="container py-5">
  <% if @range == "User" %>
    <div class="row">
      <% @users.each do |user| %>
        <div class="card mr-1" style="width: 18rem;">
          <div class="card-header">
            <%= user.name %>
          </div>
          <%= link_to user_path(user.id), class:"mx-auto" do %>
            <%= image_tag user.get_profile_image(100, 100), class:"rounded circle" %>
          <% end %> 
          <div class="card-body">
            <p class="card-text"><%= user.introduction %></p>
          </div>
          <div class="card-body">
            <p class="card-text">好きな動物：<br><%= user.favorite_animal %></p>
          </div>
        </div>
      <% end %>
    </div>
    <%= paginate @users %>
  <% else %>
    <%= render 'list', posts: @posts %>
  <% end %>
</div>
